<h1>やることリスト</h1>

<p id="notice"><%= notice %></p>
<div class="direct_form">
  <%= form_with model: @new_todo, local: false do |form| %>
    <div class="container">
      <div class="row">
        <div class="col-8">
          <div class="row">
            <div class="col-12">
              <%= form.label :name %>
              <%= form.collection_select :project_id, @projects, :id, :name, prompt: true %>
            </div>
          </div>
          <div class="row">
            <div class="col-6">
              <%= form.label :title %>
              <%= form.text_field :title %>
            </div>
            <div class="col-6">
              <%= form.label :detail %>
              <%= form.text_field :detail %>
            </div>
          </div>
        </div>
        <div class="col-4">
          <div class="actions">
            <%= form.submit "作成" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="container mt-2">
  <div class="row">
    <div class="col-10">
      <table id="todo_list">
        <thead>
          <tr>
            <th>見出し</th>
            <th>詳細</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @todos.each do |todo| %>
            <tr>
              <td><%= todo.title %></td>
              <td><%= todo.detail %></td>
              <td>
                <%= link_to todo do %>
                  <button>もっと詳しく</button>
                <% end %>
              </td>
              <td>
                <%= link_to edit_todo_path(todo) do %>
                  <button>編集</button>
                <% end %>
              </td>
              <td>
                <%= link_to todo, method: :delete do %>
                  <button>削除</button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<br>